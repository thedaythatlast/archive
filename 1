#define WIN32_LEAN_AND_MEAN
#include <Windows.h>

#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <cwchar>
#include <iostream>

static int RunTarget()
{
    constexpr SIZE_T BufferSize = 4096;

    auto* buffer = static_cast<char*>(
        VirtualAlloc(
            nullptr,
            BufferSize,
            MEM_RESERVE | MEM_COMMIT,
            PAGE_READWRITE));

    if (!buffer)
    {
        std::cerr
            << "VirtualAlloc failed. GetLastError="
            << GetLastError()
            << '\n';

        return 1;
    }

    strcpy_s(buffer, BufferSize, "BEFORE");

    std::cout
        << "PID:     "
        << GetCurrentProcessId()
        << '\n';

    std::cout
        << "Address: 0x"
        << std::hex
        << reinterpret_cast<std::uintptr_t>(buffer)
        << std::dec
        << '\n';

    std::cout
        << "Value:   "
        << buffer
        << "\n\n";

    std::cout
        << "Leave this process running.\n"
        << "Run the writer in another terminal, "
        << "then press Enter here."
        << std::endl;

    std::cin.get();

    std::cout
        << "\nValue after WriteProcessMemory: "
        << buffer
        << '\n';

    VirtualFree(buffer, 0, MEM_RELEASE);
    return 0;
}

static int RunWriter(int argc, wchar_t* argv[])
{
    if (argc != 4)
    {
        std::wcerr
            << L"Usage:\n"
            << L"  wpm_repro.exe write <PID> <hex-address>\n";

        return 1;
    }

    wchar_t* pidEnd = nullptr;

    const unsigned long parsedPid =
        std::wcstoul(argv[2], &pidEnd, 10);

    if (!pidEnd || *pidEnd != L'\0' || parsedPid == 0)
    {
        std::wcerr
            << L"Invalid PID: "
            << argv[2]
            << L'\n';

        return 1;
    }

    wchar_t* addressEnd = nullptr;

    const unsigned long long parsedAddress =
        std::wcstoull(argv[3], &addressEnd, 0);

    if (!addressEnd ||
        *addressEnd != L'\0' ||
        parsedAddress == 0)
    {
        std::wcerr
            << L"Invalid address: "
            << argv[3]
            << L'\n';

        return 1;
    }

    const DWORD pid =
        static_cast<DWORD>(parsedPid);

    void* remoteAddress =
        reinterpret_cast<void*>(
            static_cast<std::uintptr_t>(parsedAddress));

    /*
        This reproduces the access mask from the claim.

        Deliberately absent:
            PROCESS_VM_OPERATION
    */
    constexpr DWORD RequestedAccess =
        PROCESS_VM_WRITE |
        PROCESS_VM_READ |
        PROCESS_QUERY_LIMITED_INFORMATION;

    static_assert(
        (RequestedAccess & PROCESS_VM_OPERATION) == 0,
        "PROCESS_VM_OPERATION must not be requested");

    std::cout
        << "PROCESS_VM_WRITE                  = 0x"
        << std::hex
        << PROCESS_VM_WRITE
        << '\n';

    std::cout
        << "PROCESS_VM_OPERATION              = 0x"
        << PROCESS_VM_OPERATION
        << '\n';

    std::cout
        << "PROCESS_VM_READ                   = 0x"
        << PROCESS_VM_READ
        << '\n';

    std::cout
        << "PROCESS_QUERY_LIMITED_INFORMATION = 0x"
        << PROCESS_QUERY_LIMITED_INFORMATION
        << '\n';

    std::cout
        << "Requested access mask             = 0x"
        << RequestedAccess
        << std::dec
        << "\n\n";

    HANDLE process = OpenProcess(
        RequestedAccess,
        FALSE,
        pid);

    if (!process)
    {
        std::cerr
            << "OpenProcess failed. GetLastError="
            << GetLastError()
            << '\n';

        return 1;
    }

    const char replacement[] =
        "AFTER: write succeeded without VM_OPERATION";

    SIZE_T bytesWritten = 0;

    SetLastError(ERROR_SUCCESS);

    const BOOL result = WriteProcessMemory(
        process,
        remoteAddress,
        replacement,
        sizeof(replacement),
        &bytesWritten);

    const DWORD error =
        result ? ERROR_SUCCESS : GetLastError();

    std::cout
        << "WriteProcessMemory returned: "
        << (result ? "TRUE" : "FALSE")
        << '\n';

    std::cout
        << "Bytes written: "
        << bytesWritten
        << '\n';

    std::cout
        << "Error: "
        << error
        << '\n';

    CloseHandle(process);

    return result ? 0 : 1;
}

int wmain(int argc, wchar_t* argv[])
{
    if (argc == 2 &&
        std::wcscmp(argv[1], L"target") == 0)
    {
        return RunTarget();
    }

    if (argc >= 2 &&
        std::wcscmp(argv[1], L"write") == 0)
    {
        return RunWriter(argc, argv);
    }

    std::wcerr
        << L"Usage:\n"
        << L"  wpm_repro.exe target\n"
        << L"  wpm_repro.exe write <PID> <hex-address>\n";

    return 1;
}
