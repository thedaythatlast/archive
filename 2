#include <Windows.h>
#include <cstdio>

static void TestWrite(
    HANDLE process,
    const char* label,
    void* destination,
    BYTE value)
{
    SIZE_T written = 0;
    SetLastError(ERROR_SUCCESS);

    BOOL ok = WriteProcessMemory(
        process,
        destination,
        &value,
        sizeof(value),
        &written);

    DWORD error = ok ? ERROR_SUCCESS : GetLastError();

    std::printf(
        "%-30s ok=%d  written=%zu  error=%lu  value=0x%02X\n",
        label,
        ok,
        written,
        error,
        *static_cast<BYTE*>(destination));
}

int main()
{
    constexpr SIZE_T regionSize = 4096;

    BYTE* readWrite = static_cast<BYTE*>(
        VirtualAlloc(
            nullptr,
            regionSize,
            MEM_RESERVE | MEM_COMMIT,
            PAGE_READWRITE));

    BYTE* readOnly = static_cast<BYTE*>(
        VirtualAlloc(
            nullptr,
            regionSize,
            MEM_RESERVE | MEM_COMMIT,
            PAGE_READWRITE));

    BYTE* executeRead = static_cast<BYTE*>(
        VirtualAlloc(
            nullptr,
            regionSize,
            MEM_RESERVE | MEM_COMMIT,
            PAGE_READWRITE));

    if (!readWrite || !readOnly || !executeRead) {
        std::printf("VirtualAlloc failed: %lu\n", GetLastError());
        return 1;
    }

    // Initialize them while they are writable.
    readWrite[0]   = 0x11;
    readOnly[0]    = 0x22;
    executeRead[0] = 0x33;

    DWORD oldProtection;

    if (!VirtualProtect(
            readOnly,
            regionSize,
            PAGE_READONLY,
            &oldProtection)) {
        std::printf("VirtualProtect(PAGE_READONLY) failed: %lu\n",
                    GetLastError());
        return 1;
    }

    if (!VirtualProtect(
            executeRead,
            regionSize,
            PAGE_EXECUTE_READ,
            &oldProtection)) {
        std::printf("VirtualProtect(PAGE_EXECUTE_READ) failed: %lu\n",
                    GetLastError());
        return 1;
    }

    /*
        Important: this is a real handle to the current process with only
        PROCESS_VM_WRITE. PROCESS_VM_OPERATION is deliberately omitted.
    */
    HANDLE writeOnlyHandle = OpenProcess(
        PROCESS_VM_WRITE,
        FALSE,
        GetCurrentProcessId());

    if (!writeOnlyHandle) {
        std::printf("OpenProcess failed: %lu\n", GetLastError());
        return 1;
    }

    std::puts("Handle: PROCESS_VM_WRITE only");
    TestWrite(writeOnlyHandle, "PAGE_READWRITE",    readWrite,   0xAA);
    TestWrite(writeOnlyHandle, "PAGE_READONLY",     readOnly,    0xBB);
    TestWrite(writeOnlyHandle, "PAGE_EXECUTE_READ", executeRead, 0xCC);

    CloseHandle(writeOnlyHandle);

    /*
        Control run: same addresses, but now include
        PROCESS_VM_OPERATION.
    */
    HANDLE operationHandle = OpenProcess(
        PROCESS_VM_WRITE | PROCESS_VM_OPERATION,
        FALSE,
        GetCurrentProcessId());

    if (!operationHandle) {
        std::printf("Second OpenProcess failed: %lu\n", GetLastError());
        return 1;
    }

    std::puts("\nHandle: PROCESS_VM_WRITE | PROCESS_VM_OPERATION");
    TestWrite(operationHandle, "PAGE_READWRITE",    readWrite,   0xA1);
    TestWrite(operationHandle, "PAGE_READONLY",     readOnly,    0xB1);
    TestWrite(operationHandle, "PAGE_EXECUTE_READ", executeRead, 0xC1);

    CloseHandle(operationHandle);

    VirtualFree(readWrite,   0, MEM_RELEASE);
    VirtualFree(readOnly,    0, MEM_RELEASE);
    VirtualFree(executeRead, 0, MEM_RELEASE);
}


