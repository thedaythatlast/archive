#define WIN32_LEAN_AND_MEAN
#include <windows.h>
#include <authz.h>
#include <sddl.h>

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <vector>

#pragma comment(lib, "Authz.lib")
#pragma comment(lib, "Advapi32.lib")

// Permit compilation with SDKs that do not expose the symbolic name.
#ifndef CRITICAL_ACE_FLAG
#define CRITICAL_ACE_FLAG 0x20
#endif

struct AccessResult
{
    BOOL apiSucceeded;
    DWORD apiError;
    ACCESS_MASK grantedAccess;
    DWORD resultError;
};

static void PrintWin32Error(const char* operation, DWORD error)
{
    char* message = nullptr;

    FormatMessageA(
        FORMAT_MESSAGE_ALLOCATE_BUFFER |
            FORMAT_MESSAGE_FROM_SYSTEM |
            FORMAT_MESSAGE_IGNORE_INSERTS,
        nullptr,
        error,
        0,
        reinterpret_cast<char*>(&message),
        0,
        nullptr);

    std::fprintf(
        stderr,
        "%s failed: error %lu%s%s\n",
        operation,
        error,
        message ? " - " : "",
        message ? message : "");

    if (message)
    {
        LocalFree(message);
    }
}

static bool GetCurrentUserSid(std::vector<BYTE>& sidBuffer)
{
    HANDLE token = nullptr;

    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
    {
        PrintWin32Error("OpenProcessToken", GetLastError());
        return false;
    }

    DWORD requiredSize = 0;

    GetTokenInformation(
        token,
        TokenUser,
        nullptr,
        0,
        &requiredSize);

    const DWORD sizingError = GetLastError();

    if (sizingError != ERROR_INSUFFICIENT_BUFFER)
    {
        PrintWin32Error("GetTokenInformation(size)", sizingError);
        CloseHandle(token);
        return false;
    }

    std::vector<BYTE> tokenUserBuffer(requiredSize);

    if (!GetTokenInformation(
            token,
            TokenUser,
            tokenUserBuffer.data(),
            requiredSize,
            &requiredSize))
    {
        PrintWin32Error("GetTokenInformation(data)", GetLastError());
        CloseHandle(token);
        return false;
    }

    CloseHandle(token);

    const TOKEN_USER* tokenUser =
        reinterpret_cast<const TOKEN_USER*>(tokenUserBuffer.data());

    const DWORD sidLength = GetLengthSid(tokenUser->User.Sid);

    sidBuffer.resize(sidLength);

    if (!CopySid(
            sidLength,
            sidBuffer.data(),
            tokenUser->User.Sid))
    {
        PrintWin32Error("CopySid", GetLastError());
        return false;
    }

    return true;
}

static bool BuildBaseAcl(
    PSID sid,
    ACCESS_MASK aceMask,
    std::vector<BYTE>& aclBuffer)
{
    const DWORD sidLength = GetLengthSid(sid);

    const DWORD aceLength =
        static_cast<DWORD>(
            sizeof(ACCESS_ALLOWED_ACE) -
            sizeof(DWORD) +
            sidLength);

    const DWORD aclLength =
        static_cast<DWORD>(sizeof(ACL)) + aceLength;

    aclBuffer.assign(aclLength, 0);

    PACL acl = reinterpret_cast<PACL>(aclBuffer.data());

    if (!InitializeAcl(acl, aclLength, ACL_REVISION))
    {
        PrintWin32Error("InitializeAcl", GetLastError());
        return false;
    }

    // Both ACLs initially contain this exact same ACE.
    if (!AddAccessAllowedAceEx(
            acl,
            ACL_REVISION,
            0,
            aceMask,
            sid))
    {
        PrintWin32Error("AddAccessAllowedAceEx", GetLastError());
        return false;
    }

    return true;
}

static bool GetOnlyAceHeader(
    PACL acl,
    ACE_HEADER*& header)
{
    void* ace = nullptr;

    if (!GetAce(acl, 0, &ace))
    {
        PrintWin32Error("GetAce", GetLastError());
        return false;
    }

    header = static_cast<ACE_HEADER*>(ace);
    return true;
}

static bool VerifyAclDifference(
    const std::vector<BYTE>& withoutCr,
    const std::vector<BYTE>& withCr,
    SIZE_T expectedChangedOffset)
{
    if (withoutCr.size() != withCr.size())
    {
        std::fprintf(
            stderr,
            "ACL sizes differ: %zu versus %zu\n",
            withoutCr.size(),
            withCr.size());

        return false;
    }

    SIZE_T differenceCount = 0;
    SIZE_T actualChangedOffset = 0;

    for (SIZE_T i = 0; i < withoutCr.size(); ++i)
    {
        if (withoutCr[i] != withCr[i])
        {
            ++differenceCount;
            actualChangedOffset = i;

            std::printf(
                "ACL byte difference: offset %zu, "
                "without CR = 0x%02X, with CR = 0x%02X\n",
                i,
                static_cast<unsigned>(withoutCr[i]),
                static_cast<unsigned>(withCr[i]));
        }
    }

    if (differenceCount != 1)
    {
        std::fprintf(
            stderr,
            "Expected exactly one differing ACL byte; found %zu.\n",
            differenceCount);

        return false;
    }

    if (actualChangedOffset != expectedChangedOffset)
    {
        std::fprintf(
            stderr,
            "The changed byte was not the intended AceFlags byte. "
            "Expected offset %zu, got %zu.\n",
            expectedChangedOffset,
            actualChangedOffset);

        return false;
    }

    return true;
}

static bool BuildSecurityDescriptor(
    PACL acl,
    PSID ownerAndGroupSid,
    SECURITY_DESCRIPTOR& securityDescriptor)
{
    if (!InitializeSecurityDescriptor(
            &securityDescriptor,
            SECURITY_DESCRIPTOR_REVISION))
    {
        PrintWin32Error(
            "InitializeSecurityDescriptor",
            GetLastError());

        return false;
    }

    if (!SetSecurityDescriptorOwner(
            &securityDescriptor,
            ownerAndGroupSid,
            FALSE))
    {
        PrintWin32Error(
            "SetSecurityDescriptorOwner",
            GetLastError());

        return false;
    }

    if (!SetSecurityDescriptorGroup(
            &securityDescriptor,
            ownerAndGroupSid,
            FALSE))
    {
        PrintWin32Error(
            "SetSecurityDescriptorGroup",
            GetLastError());

        return false;
    }

    if (!SetSecurityDescriptorDacl(
            &securityDescriptor,
            TRUE,
            acl,
            FALSE))
    {
        PrintWin32Error(
            "SetSecurityDescriptorDacl",
            GetLastError());

        return false;
    }

    if (!IsValidSecurityDescriptor(&securityDescriptor))
    {
        std::fprintf(
            stderr,
            "IsValidSecurityDescriptor returned FALSE.\n");

        return false;
    }

    return true;
}


static AccessResult RunAccessCheck(
    AUTHZ_CLIENT_CONTEXT_HANDLE clientContext,
    PSECURITY_DESCRIPTOR securityDescriptor,
    ACCESS_MASK requestedAccess)
{
    AccessResult result = {};

    AUTHZ_ACCESS_REQUEST request = {};
    request.DesiredAccess = requestedAccess;
    request.PrincipalSelfSid = nullptr;
    request.ObjectTypeList = nullptr;
    request.ObjectTypeListLength = 0;
    request.OptionalArguments = nullptr;

    ACCESS_MASK grantedAccess = 0;
    DWORD resultError = ERROR_SUCCESS;

    AUTHZ_ACCESS_REPLY reply = {};
    reply.ResultListLength = 1;
    reply.GrantedAccessMask = &grantedAccess;
    reply.Error = &resultError;
    reply.SaclEvaluationResults = nullptr;

    SetLastError(ERROR_SUCCESS);

    result.apiSucceeded = AuthzAccessCheck(
        0,
        clientContext,
        &request,
        nullptr,
        securityDescriptor,
        nullptr,
        0,
        &reply,
        nullptr);

    result.apiError =
        result.apiSucceeded ? ERROR_SUCCESS : GetLastError();

    result.grantedAccess = grantedAccess;
    result.resultError = resultError;

    return result;
}

static void FormatResult(
    const AccessResult& result,
    char* buffer,
    size_t bufferSize)
{
    if (!result.apiSucceeded)
    {
        std::snprintf(
            buffer,
            bufferSize,
            "API_FAIL/%lu",
            result.apiError);

        return;
    }

    std::snprintf(
        buffer,
        bufferSize,
        "0x%08lX/%lu",
        static_cast<unsigned long>(result.grantedAccess),
        result.resultError);
}

int main()
{
    // Arbitrary test bits, deliberately kept as raw specific access bits.
    constexpr ACCESS_MASK TEST_READ  = 0x00000001;
    constexpr ACCESS_MASK TEST_WRITE = 0x00000002;
    constexpr ACCESS_MASK TEST_OTHER = 0x00000004;

    constexpr ACCESS_MASK ACE_MASK =
        TEST_READ | TEST_WRITE;

    std::vector<BYTE> userSid;

    if (!GetCurrentUserSid(userSid))
    {
        return 1;
    }

    LPSTR sidString = nullptr;

    if (!ConvertSidToStringSidA(userSid.data(), &sidString))
    {
        PrintWin32Error("ConvertSidToStringSidA", GetLastError());
        return 1;
    }

    std::printf("Client/ACE SID: %s\n", sidString);
    std::printf("ACE access mask: 0x%08lX\n\n",
                static_cast<unsigned long>(ACE_MASK));

    LocalFree(sidString);

    std::vector<BYTE> aclWithoutCr;

    if (!BuildBaseAcl(
            userSid.data(),
            ACE_MASK,
            aclWithoutCr))
    {
        return 1;
    }

    // Make a byte-for-byte copy before changing the intended flag bit.
    std::vector<BYTE> aclWithCr = aclWithoutCr;

    PACL withoutCrAcl =
        reinterpret_cast<PACL>(aclWithoutCr.data());

    PACL withCrAcl =
        reinterpret_cast<PACL>(aclWithCr.data());

    ACE_HEADER* withoutCrHeader = nullptr;
    ACE_HEADER* withCrHeader = nullptr;

    if (!GetOnlyAceHeader(withoutCrAcl, withoutCrHeader) ||
        !GetOnlyAceHeader(withCrAcl, withCrHeader))
    {
        return 1;
    }

    // The sole intended mutation.
    withCrHeader->AceFlags =
        static_cast<BYTE>(
            withCrHeader->AceFlags | CRITICAL_ACE_FLAG);

    // Read the headers again from the final ACL buffers.
    if (!GetOnlyAceHeader(withoutCrAcl, withoutCrHeader) ||
        !GetOnlyAceHeader(withCrAcl, withCrHeader))
    {
        return 1;
    }

    const SIZE_T flagsOffset =
        static_cast<const BYTE*>(
            static_cast<const void*>(
                &withCrHeader->AceFlags)) -
        aclWithCr.data();

    std::printf(
        "Actual ACE header flags:\n"
        "  Without CR: 0x%02X\n"
        "  With CR:    0x%02X\n"
        "  CR mask:    0x%02X\n\n",
        static_cast<unsigned>(withoutCrHeader->AceFlags),
        static_cast<unsigned>(withCrHeader->AceFlags),
        static_cast<unsigned>(CRITICAL_ACE_FLAG));

    if ((withoutCrHeader->AceFlags & CRITICAL_ACE_FLAG) != 0)
    {
        std::fprintf(
            stderr,
            "Unexpected: the baseline ACE already has the CR bit.\n");

        return 1;
    }

    if ((withCrHeader->AceFlags & CRITICAL_ACE_FLAG) == 0)
    {
        std::fprintf(
            stderr,
            "Unexpected: the modified ACE does not have the CR bit.\n");

        return 1;
    }

    if (!VerifyAclDifference(
            aclWithoutCr,
            aclWithCr,
            flagsOffset))
    {
        return 1;
    }

    std::printf(
        "Verified: ACLs have equal size and differ in exactly "
        "the intended AceFlags byte.\n\n");

    SECURITY_DESCRIPTOR sdWithoutCr = {};
    SECURITY_DESCRIPTOR sdWithCr = {};

    if (!BuildSecurityDescriptor(
        withoutCrAcl,
        userSid.data(),
        sdWithoutCr) ||
    !BuildSecurityDescriptor(
        withCrAcl,
        userSid.data(),
        sdWithCr))
    {
        return 1;
    }

    AUTHZ_RESOURCE_MANAGER_HANDLE resourceManager = nullptr;

    if (!AuthzInitializeResourceManager(
            AUTHZ_RM_FLAG_NO_AUDIT,
            nullptr,
            nullptr,
            nullptr,
            L"CriticalAceFlagRepro",
            &resourceManager))
    {
        PrintWin32Error(
            "AuthzInitializeResourceManager",
            GetLastError());

        return 1;
    }

    HANDLE processToken = nullptr;

    if (!OpenProcessToken(
            GetCurrentProcess(),
            TOKEN_QUERY,
            &processToken))
    {
        PrintWin32Error("OpenProcessToken", GetLastError());
        AuthzFreeResourceManager(resourceManager);
        return 1;
    }

    AUTHZ_CLIENT_CONTEXT_HANDLE clientContext = nullptr;
    LUID identifier = {};

    if (!AuthzInitializeContextFromToken(
            0,
            processToken,
            resourceManager,
            nullptr,
            identifier,
            nullptr,
            &clientContext))
    {
        PrintWin32Error(
            "AuthzInitializeContextFromToken",
            GetLastError());

        CloseHandle(processToken);
        AuthzFreeResourceManager(resourceManager);
        return 1;
    }

    CloseHandle(processToken);

    const ACCESS_MASK requests[] =
    {
        TEST_READ,
        TEST_WRITE,
        TEST_READ | TEST_WRITE,
        TEST_OTHER,
        TEST_READ | TEST_OTHER
    };

    std::printf(
        "%-17s | %-22s | %-22s | %-13s\n",
        "RequestedAccess",
        "Without CR",
        "With CR",
        "ACE flags");

    std::printf(
        "------------------+------------------------+"
        "------------------------+--------------\n");

    for (const ACCESS_MASK requestedAccess : requests)
    {
        const AccessResult withoutCrResult =
            RunAccessCheck(
                clientContext,
                &sdWithoutCr,
                requestedAccess);

        const AccessResult withCrResult =
            RunAccessCheck(
                clientContext,
                &sdWithCr,
                requestedAccess);

        char withoutCrText[64] = {};
        char withCrText[64] = {};

        FormatResult(
            withoutCrResult,
            withoutCrText,
            sizeof(withoutCrText));

        FormatResult(
            withCrResult,
            withCrText,
            sizeof(withCrText));

        std::printf(
            "0x%08lX        | %-22s | %-22s | 0x%02X / 0x%02X\n",
            static_cast<unsigned long>(requestedAccess),
            withoutCrText,
            withCrText,
            static_cast<unsigned>(withoutCrHeader->AceFlags),
            static_cast<unsigned>(withCrHeader->AceFlags));
    }

    std::printf(
        "\nEach result cell is: GrantedAccess/AuthzResultError.\n"
        "API_FAIL/N means AuthzAccessCheck itself returned FALSE "
        "with GetLastError() == N.\n");

    AuthzFreeContext(clientContext);
    AuthzFreeResourceManager(resourceManager);

    return 0;
}

