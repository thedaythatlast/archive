#define WIN32_LEAN_AND_MEAN
#define NOMINMAX

#include <windows.h>
#include <tlhelp32.h>
#include <sstream>
#include <cstdint>
#include <cstring>
#include <iomanip>
#include <iostream>
#include <limits>
#include <string>
#include <vector>

#pragma comment(lib, "advapi32.lib")

namespace
{
    // Use the numeric values deliberately so the probe can be compiled with
    // SDKs where TokenIsLessPrivilegedAppContainer is not named in winnt.h.
    constexpr TOKEN_INFORMATION_CLASS kTokenIsAppContainer =
        static_cast<TOKEN_INFORMATION_CLASS>(29);

    constexpr TOKEN_INFORMATION_CLASS kClass46 =
        static_cast<TOKEN_INFORMATION_CLASS>(46);

    constexpr DWORD kSentinelReturnLength = 0xCCCCCCCCu;
    constexpr BYTE  kSentinelByte = 0xCC;

    struct ScopedHandle
    {
        HANDLE value = nullptr;

        ScopedHandle() = default;
        explicit ScopedHandle(HANDLE h) : value(h) {}

        ScopedHandle(const ScopedHandle&) = delete;
        ScopedHandle& operator=(const ScopedHandle&) = delete;

        ScopedHandle(ScopedHandle&& other) noexcept : value(other.value)
        {
            other.value = nullptr;
        }

        ScopedHandle& operator=(ScopedHandle&& other) noexcept
        {
            if (this != &other)
            {
                reset();
                value = other.value;
                other.value = nullptr;
            }
            return *this;
        }

        ~ScopedHandle()
        {
            reset();
        }

        void reset(HANDLE h = nullptr)
        {
            if (value != nullptr && value != INVALID_HANDLE_VALUE)
            {
                CloseHandle(value);
            }
            value = h;
        }

        HANDLE get() const
        {
            return value;
        }

        HANDLE release()
        {
            HANDLE h = value;
            value = nullptr;
            return h;
        }

        explicit operator bool() const
        {
            return value != nullptr && value != INVALID_HANDLE_VALUE;
        }
    };

    struct CallResult
    {
        BOOL success = FALSE;
        DWORD returnLength = kSentinelReturnLength;
        DWORD lastError = ERROR_SUCCESS;
        std::vector<BYTE> bytes;
    };

    struct TokenProbeResult
    {
        std::string tokenName;
        DWORD processId = 0;

        bool appContainerQuerySucceeded = false;
        DWORD isAppContainer = 0;
        DWORD appContainerError = ERROR_SUCCESS;

        CallResult sizingCall;
        CallResult class46Call;
    };

    std::string ErrorName(DWORD error)
    {
        switch (error)
        {
        case ERROR_SUCCESS:
            return "ERROR_SUCCESS";
        case ERROR_ACCESS_DENIED:
            return "ERROR_ACCESS_DENIED";
        case ERROR_INSUFFICIENT_BUFFER:
            return "ERROR_INSUFFICIENT_BUFFER";
        case ERROR_INVALID_PARAMETER:
            return "ERROR_INVALID_PARAMETER";
        case ERROR_INVALID_HANDLE:
            return "ERROR_INVALID_HANDLE";
        case ERROR_BAD_LENGTH:
            return "ERROR_BAD_LENGTH";
        case ERROR_NO_TOKEN:
            return "ERROR_NO_TOKEN";
        default:
            return "";
        }
    }

    std::string FormatError(DWORD error)
    {
        const std::string name = ErrorName(error);
        if (!name.empty())
        {
            return std::to_string(error) + " (" + name + ")";
        }

        return std::to_string(error);
    }

    std::string BytesToHex(const std::vector<BYTE>& bytes)
    {
        if (bytes.empty())
        {
            return "<none>";
        }

        std::ostringstream stream;
        stream << std::hex << std::uppercase << std::setfill('0');

        for (std::size_t i = 0; i < bytes.size(); ++i)
        {
            if (i != 0)
            {
                stream << ' ';
            }

            stream << std::setw(2)
                   << static_cast<unsigned int>(bytes[i]);
        }

        return stream.str();
    }

    std::string DecodeReturnedValue(const CallResult& result)
    {
        if (!result.success)
        {
            return "<invalid because call failed>";
        }

        if (result.bytes.empty())
        {
            return "<no returned bytes>";
        }

        if (result.bytes.size() >= sizeof(DWORD))
        {
            DWORD value = 0;
            std::memcpy(&value, result.bytes.data(), sizeof(value));
            return std::to_string(value);
        }

        return "<fewer than sizeof(DWORD) bytes>";
    }

    bool QueryIsAppContainer(
        HANDLE token,
        DWORD& isAppContainer,
        DWORD& error)
    {
        isAppContainer = 0xCCCCCCCCu;
        DWORD returnLength = kSentinelReturnLength;

        SetLastError(ERROR_SUCCESS);

        const BOOL ok = GetTokenInformation(
            token,
            kTokenIsAppContainer,
            &isAppContainer,
            static_cast<DWORD>(sizeof(isAppContainer)),
            &returnLength);

        error = ok ? ERROR_SUCCESS : GetLastError();
        return ok != FALSE;
    }

    CallResult MakeSizingCall(HANDLE token)
    {
        CallResult result;
        result.returnLength = kSentinelReturnLength;

        SetLastError(ERROR_SUCCESS);

        result.success = GetTokenInformation(
            token,
            kClass46,
            nullptr,
            0,
            &result.returnLength);

        result.lastError =
            result.success ? ERROR_SUCCESS : GetLastError();

        return result;
    }

    CallResult MakeRetrievalCall(
        HANDLE token,
        const CallResult& sizingResult)
    {
        CallResult result;

        /*
         * If the sizing call supplied a plausible nonzero length, use it.
         * Otherwise still make a direct sizeof(DWORD) query.
         *
         * The direct fallback is important here: if class 46 rejects the
         * null-buffer sizing form but accepts a fixed DWORD-sized buffer,
         * the probe will expose that distinction instead of incorrectly
         * concluding that class 46 is wholly unsupported.
         */
        DWORD bufferLength = sizeof(DWORD);

        if (sizingResult.returnLength != 0 &&
            sizingResult.returnLength != kSentinelReturnLength &&
            sizingResult.returnLength <= 1024 * 1024)
        {
            bufferLength = sizingResult.returnLength;
        }

        result.bytes.assign(bufferLength, kSentinelByte);
        result.returnLength = kSentinelReturnLength;

        SetLastError(ERROR_SUCCESS);

        result.success = GetTokenInformation(
            token,
            kClass46,
            result.bytes.data(),
            bufferLength,
            &result.returnLength);

        result.lastError =
            result.success ? ERROR_SUCCESS : GetLastError();

        /*
         * Keep the entire supplied buffer, including untouched 0xCC bytes.
         * This makes partial writes or an unexpected ReturnLength visible.
         */
        return result;
    }

    TokenProbeResult ProbeToken(
        const std::string& tokenName,
        DWORD processId,
        HANDLE token)
    {
        TokenProbeResult result;
        result.tokenName = tokenName;
        result.processId = processId;

        result.appContainerQuerySucceeded = QueryIsAppContainer(
            token,
            result.isAppContainer,
            result.appContainerError);

        result.sizingCall = MakeSizingCall(token);
        result.class46Call = MakeRetrievalCall(
            token,
            result.sizingCall);

        return result;
    }

    ScopedHandle FindAccessibleAppContainerToken(
        DWORD& processId,
        std::wstring& executableName,
        DWORD& processesExamined,
        DWORD& processOpenFailures,
        DWORD& tokenOpenFailures)
    {
        processId = 0;
        executableName.clear();
        processesExamined = 0;
        processOpenFailures = 0;
        tokenOpenFailures = 0;

        ScopedHandle snapshot(CreateToolhelp32Snapshot(
            TH32CS_SNAPPROCESS,
            0));

        if (!snapshot)
        {
            return {};
        }

        PROCESSENTRY32W entry{};
        entry.dwSize = sizeof(entry);

        if (!Process32FirstW(snapshot.get(), &entry))
        {
            return {};
        }

        do
        {
            ++processesExamined;

            if (entry.th32ProcessID == 0 ||
                entry.th32ProcessID == GetCurrentProcessId())
            {
                continue;
            }

            ScopedHandle process(OpenProcess(
                PROCESS_QUERY_LIMITED_INFORMATION,
                FALSE,
                entry.th32ProcessID));

            if (!process)
            {
                ++processOpenFailures;
                continue;
            }

            HANDLE rawToken = nullptr;

            if (!OpenProcessToken(
                    process.get(),
                    TOKEN_QUERY,
                    &rawToken))
            {
                ++tokenOpenFailures;
                continue;
            }

            ScopedHandle token(rawToken);

            DWORD isAppContainer = 0;
            DWORD queryError = ERROR_SUCCESS;

            if (!QueryIsAppContainer(
                    token.get(),
                    isAppContainer,
                    queryError))
            {
                continue;
            }

            if (isAppContainer != 0)
            {
                processId = entry.th32ProcessID;
                executableName = entry.szExeFile;
                return token;
            }
        }
        while (Process32NextW(snapshot.get(), &entry));

        return {};
    }

    void PrintDetailedCall(
        const char* label,
        const CallResult& result)
    {
        std::cout
            << "  " << label << '\n'
            << "    BOOL return       : "
            << static_cast<int>(result.success) << '\n'
            << "    ReturnLength      : "
            << result.returnLength
            << " (0x" << std::hex << std::uppercase
            << result.returnLength << std::dec << ")\n"
            << "    GetLastError      : "
            << FormatError(result.lastError) << '\n';

        if (!result.bytes.empty())
        {
            std::cout
                << "    supplied buffer   : "
                << result.bytes.size() << " bytes\n"
                << "    raw buffer bytes  : "
                << BytesToHex(result.bytes) << '\n'
                << "    DWORD interpretation: "
                << DecodeReturnedValue(result) << '\n';
        }
    }

    void PrintDetails(const TokenProbeResult& result)
    {
        std::cout << "\n=== " << result.tokenName << " ===\n";

        if (result.processId != 0)
        {
            std::cout << "Process ID           : "
                      << result.processId << '\n';
        }

        std::cout << "TokenIsAppContainer  : ";

        if (result.appContainerQuerySucceeded)
        {
            std::cout << result.isAppContainer << '\n';
        }
        else
        {
            std::cout
                << "<query failed>, GetLastError="
                << FormatError(result.appContainerError)
                << '\n';
        }

        PrintDetailedCall(
            "Class 46 sizing call: buffer=NULL, length=0",
            result.sizingCall);

        PrintDetailedCall(
            "Class 46 retrieval call",
            result.class46Call);
    }

    void PrintSummaryHeader()
    {
        std::cout
            << "\nSUMMARY\n"
            << std::left
            << std::setw(28) << "Token"
            << std::setw(17) << "IsAppContainer"
            << std::setw(19) << "class 46 success"
            << std::setw(15) << "ReturnLength"
            << std::setw(34) << "returned value/raw bytes"
            << "GetLastError\n";

        std::cout << std::string(130, '-') << '\n';
    }

    void PrintSummaryRow(const TokenProbeResult& result)
    {
        std::string appContainerText;

        if (result.appContainerQuerySucceeded)
        {
            appContainerText = std::to_string(
                result.isAppContainer);
        }
        else
        {
            appContainerText =
                "failed:" +
                std::to_string(result.appContainerError);
        }

        std::string valueAndBytes;

        if (result.class46Call.success)
        {
            valueAndBytes =
                DecodeReturnedValue(result.class46Call) +
                " / " +
                BytesToHex(result.class46Call.bytes);
        }
        else
        {
            valueAndBytes =
                "<invalid> / " +
                BytesToHex(result.class46Call.bytes);
        }

        std::cout
            << std::left
            << std::setw(28) << result.tokenName
            << std::setw(17) << appContainerText
            << std::setw(19)
            << (result.class46Call.success ? "TRUE (1)" : "FALSE (0)")
            << std::setw(15) << result.class46Call.returnLength
            << std::setw(34) << valueAndBytes
            << FormatError(result.class46Call.lastError)
            << '\n';
    }
}

int main()
{
    std::cout
        << "GetTokenInformation class 46 probe\n"
        << "PID: " << GetCurrentProcessId() << "\n"
        << "Class 46 is passed numerically as "
        << static_cast<int>(kClass46) << ".\n";

    std::vector<TokenProbeResult> results;

    HANDLE rawCurrentToken = nullptr;

    if (!OpenProcessToken(
            GetCurrentProcess(),
            TOKEN_QUERY,
            &rawCurrentToken))
    {
        const DWORD error = GetLastError();

        std::cerr
            << "OpenProcessToken(current process) failed: "
            << FormatError(error) << '\n';

        return 1;
    }

    ScopedHandle currentToken(rawCurrentToken);

    results.push_back(ProbeToken(
        "Current process",
        GetCurrentProcessId(),
        currentToken.get()));

    DWORD appContainerPid = 0;
    std::wstring appContainerExe;
    DWORD processesExamined = 0;
    DWORD processOpenFailures = 0;
    DWORD tokenOpenFailures = 0;

    ScopedHandle appContainerToken =
        FindAccessibleAppContainerToken(
            appContainerPid,
            appContainerExe,
            processesExamined,
            processOpenFailures,
            tokenOpenFailures);

    if (appContainerToken)
    {
        std::string tokenName = "Existing AppContainer";

        results.push_back(ProbeToken(
            tokenName,
            appContainerPid,
            appContainerToken.get()));

        std::wcout
            << L"\nFound an accessible AppContainer process:"
            << L"\n  executable: " << appContainerExe
            << L"\n  PID       : " << appContainerPid
            << L'\n';
    }
    else
    {
        std::cout
            << "\nNo accessible AppContainer token was found by the "
               "lightweight process scan.\n"
            << "No AppContainer profile or elaborate launcher was created.\n"
            << "Processes examined    : " << processesExamined << '\n'
            << "Process-open failures : " << processOpenFailures << '\n'
            << "Token-open failures   : " << tokenOpenFailures << '\n';
    }

    for (const TokenProbeResult& result : results)
    {
        PrintDetails(result);
    }

    PrintSummaryHeader();

    for (const TokenProbeResult& result : results)
    {
        PrintSummaryRow(result);
    }

    return 0;
}

