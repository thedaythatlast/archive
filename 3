#define NOMINMAX
#include <Windows.h>
#include <winternl.h>

#include <cstddef>
#include <cstdio>
#include <cwchar>

using NtQueryInformationProcess_t = NTSTATUS(NTAPI*)(
    HANDLE,
    PROCESSINFOCLASS,
    PVOID,
    ULONG,
    PULONG
);

static void PrintProtection(DWORD protection)
{
    protection &= 0xFF;

    switch (protection) {
    case PAGE_NOACCESS:
        std::printf("PAGE_NOACCESS");
        break;
    case PAGE_READONLY:
        std::printf("PAGE_READONLY");
        break;
    case PAGE_READWRITE:
        std::printf("PAGE_READWRITE");
        break;
    case PAGE_WRITECOPY:
        std::printf("PAGE_WRITECOPY");
        break;
    case PAGE_EXECUTE:
        std::printf("PAGE_EXECUTE");
        break;
    case PAGE_EXECUTE_READ:
        std::printf("PAGE_EXECUTE_READ");
        break;
    case PAGE_EXECUTE_READWRITE:
        std::printf("PAGE_EXECUTE_READWRITE");
        break;
    case PAGE_EXECUTE_WRITECOPY:
        std::printf("PAGE_EXECUTE_WRITECOPY");
        break;
    default:
        std::printf("unknown protection 0x%08lX", protection);
        break;
    }
}

static void DescribeAddress(const char* name, void* address)
{
    MEMORY_BASIC_INFORMATION mbi{};

    SIZE_T result = VirtualQuery(
        address,
        &mbi,
        sizeof(mbi));

    if (result == 0) {
        std::printf(
            "%s: VirtualQuery failed: %lu\n",
            name,
            GetLastError());

        return;
    }

    std::printf(
        "%s=%p  allocationBase=%p  state=0x%08lX  type=0x%08lX  protection=",
        name,
        address,
        mbi.AllocationBase,
        mbi.State,
        mbi.Type);

    PrintProtection(mbi.Protect);
    std::printf("\n");
}

static bool ReadExact(
    HANDLE process,
    const void* address,
    void* destination,
    SIZE_T size)
{
    SIZE_T bytesRead = 0;

    BOOL ok = ReadProcessMemory(
        process,
        address,
        destination,
        size,
        &bytesRead);

    if (!ok || bytesRead != size) {
        std::printf(
            "ReadProcessMemory(%p) failed: ok=%d read=%zu error=%lu\n",
            address,
            ok,
            bytesRead,
            GetLastError());

        return false;
    }

    return true;
}

template<typename T>
static bool ReadValue(
    HANDLE process,
    const void* address,
    T& value)
{
    return ReadExact(
        process,
        address,
        &value,
        sizeof(value));
}

static bool ReadRemoteString(
    HANDLE process,
    const UNICODE_STRING& string,
    wchar_t* buffer,
    SIZE_T bufferCount)
{
    if (bufferCount == 0)
        return false;

    SIZE_T characters = string.Length / sizeof(wchar_t);

    if (characters >= bufferCount)
        characters = bufferCount - 1;

    if (characters != 0) {
        if (!ReadExact(
                process,
                string.Buffer,
                buffer,
                characters * sizeof(wchar_t))) {
            return false;
        }
    }

    buffer[characters] = L'\0';
    return true;
}

static void TestSameValueWrite(
    HANDLE process,
    const char* description,
    void* destination)
{
    void* currentValue = nullptr;

    if (!ReadValue(process, destination, currentValue)) {
        std::printf(
            "%-38s could not read destination\n",
            description);

        return;
    }

    SIZE_T bytesWritten = 0;
    SetLastError(ERROR_SUCCESS);

    BOOL ok = WriteProcessMemory(
        process,
        destination,
        &currentValue,
        sizeof(currentValue),
        &bytesWritten);

    DWORD error = ok ? ERROR_SUCCESS : GetLastError();

    std::printf(
        "%-38s address=%p value=%p ok=%d written=%zu error=%lu\n",
        description,
        destination,
        currentValue,
        ok,
        bytesWritten,
        error);
}

static bool TestKernelBaseListLinks(HANDLE process)
{
    HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");

    auto NtQueryInformationProcess =
        reinterpret_cast<NtQueryInformationProcess_t>(
            GetProcAddress(
                ntdll,
                "NtQueryInformationProcess"));

    if (!NtQueryInformationProcess) {
        std::printf("Could not resolve NtQueryInformationProcess\n");
        return false;
    }

    PROCESS_BASIC_INFORMATION pbi{};

    NTSTATUS status = NtQueryInformationProcess(
        process,
        ProcessBasicInformation,
        &pbi,
        sizeof(pbi),
        nullptr);

    if (status < 0) {
        std::printf(
            "NtQueryInformationProcess failed: 0x%08lX\n",
            static_cast<unsigned long>(status));

        return false;
    }

    PEB peb{};

    if (!ReadValue(process, pbi.PebBaseAddress, peb))
        return false;

    PEB_LDR_DATA ldr{};

    if (!ReadValue(process, peb.Ldr, ldr))
        return false;

    auto listHead = reinterpret_cast<LIST_ENTRY*>(
        reinterpret_cast<BYTE*>(peb.Ldr) +
        offsetof(PEB_LDR_DATA, InMemoryOrderModuleList));

    LIST_ENTRY current{};

    if (!ReadValue(process, listHead, current))
        return false;

    for (LIST_ENTRY* link = current.Flink;
         link != listHead;
         link = current.Flink) {

        auto entryAddress =
            CONTAINING_RECORD(
                link,
                LDR_DATA_TABLE_ENTRY,
                InMemoryOrderLinks);

        LDR_DATA_TABLE_ENTRY entry{};

        if (!ReadValue(process, entryAddress, entry))
            return false;

        wchar_t moduleName[260]{};

        if (!ReadRemoteString(
                process,
                entry.FullDllName,
                moduleName,
                _countof(moduleName))) {
            return false;
        }

        if (!ReadValue(process, link, current))
            return false;

        if (_wcsicmp(moduleName, L"kernelbase.dll") != 0 &&
            _wcsicmp(
                wcsrchr(moduleName, L'\\')
                    ? wcsrchr(moduleName, L'\\') + 1
                    : moduleName,
                L"kernelbase.dll") != 0) {
            continue;
        }

        std::wprintf(
            L"\nFound: %ls\n",
            moduleName);

        /*
            HideDll performs:

              current.Blink->Flink = current.Flink
              current.Flink->Blink = current.Blink

            Those destinations are represented below. However, this repro
            writes the existing value back to each destination instead of
            unlinking kernelbase.dll.
        */

        void* previousFlinkAddress =
            &current.Blink->Flink;

        void* nextBlinkAddress =
            &current.Flink->Blink;

        DescribeAddress(
            "previous entry's Flink",
            previousFlinkAddress);

        DescribeAddress(
            "next entry's Blink",
            nextBlinkAddress);

        TestSameValueWrite(
            process,
            "previous entry's Flink",
            previousFlinkAddress);

        TestSameValueWrite(
            process,
            "next entry's Blink",
            nextBlinkAddress);

        return true;
    }

    std::printf("kernelbase.dll was not found\n");
    return false;
}

static void RunTest(DWORD access, const char* description)
{
    std::printf("\n=== %s ===\n", description);
    std::printf("Requested access mask: 0x%08lX\n", access);

    HANDLE process = OpenProcess(
        access,
        FALSE,
        GetCurrentProcessId());

    if (!process) {
        std::printf(
            "OpenProcess failed: %lu\n",
            GetLastError());

        return;
    }

    TestKernelBaseListLinks(process);
    CloseHandle(process);
}

int main()
{
    constexpr DWORD hideDllAccess =
        PROCESS_VM_READ |
        PROCESS_VM_WRITE |
        PROCESS_QUERY_LIMITED_INFORMATION;

    RunTest(
        hideDllAccess,
        "HideDll access, without PROCESS_VM_OPERATION");

    RunTest(
        hideDllAccess | PROCESS_VM_OPERATION,
        "Same access, with PROCESS_VM_OPERATION");

    return 0;
}


