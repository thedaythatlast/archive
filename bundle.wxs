<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <Package
      Id="john.mtls"
      Name="mtls"
      Manufacturer="john"
      Version="0.0.1">

    <File Source="publish\MtlsServer.exe" />
    <File Source="publish\appsettings.Development.json" />
    <File Source="publish\Microsoft.AspNetCore.Authentication.Certificate.dll" />
    <File Source="publish\MtlsServer.pdb" />
    <File Source="publish\MtlsServer.staticwebassets.endpoints.json" />
    <File Source="publish\MtlsServer.dll" />
    <File Source="publish\MtlsServer.deps.json" />
    <File Source="publish\MtlsServer.runtimeconfig.json" />
    <File Source="publish\appsettings.json" />

    <!--
      Sets DOTNET10CHECK to:
        0     = compatible runtime found
        12289 = no runtime installed
        12290 = required runtime missing
        other = detection failure
    -->
    <netfx:DotNetCompatibilityCheck
    Id="CheckDotNet10DesktopX64"
    Property="DOTNET10CHECK"
    Version="10.0.0"
    RuntimeType="desktop"
    Platform="x64"
    RollForward="latestPatch" />

<Binary
    Id="DotNet10DesktopInstaller"
    SourceFile="windowsdesktop-runtime-10.0.14-win-x64.exe" />

<CustomAction
    Id="InstallDotNet10Desktop"
    BinaryRef="DotNet10DesktopInstaller"
    ExeCommand="/install /quiet /norestart"
    Execute="immediate"
    Return="check" />

<InstallExecuteSequence>
  <Custom
      Action="InstallDotNet10Desktop"
      After="InstallFinalize"
      Condition="NOT Installed AND DOTNET10CHECK &lt;&gt; &quot;0&quot;" />
</InstallExecuteSequence>


  </Package>
</Wix>
